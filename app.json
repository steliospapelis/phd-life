{
  "expo": {
    "name": "PhD Life",
    "slug": "phd-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./images/branding/phd-life-app-icon.png",
    "scheme": "phdlife",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.phdlife"
    },
    "android": {
      "package": "com.example.phdlife",
      "adaptiveIcon": {
        "foregroundImage": "./images/branding/phd-life-app-icon.png",
        "backgroundColor": "#F7F3E8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "645d8e4f-941d-4660-a324-b2769eabf5d8"
      }
    }
  }
}
